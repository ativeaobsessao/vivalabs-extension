{
  "manifest_version": 3,
  "name": "Viva Spy",
  "version": "1.8.0",
  "description": "Inteligência de anúncios para a Meta Ad Library: encontre as ofertas mais escaladas, em segundos.",
  "permissions": [
    "storage",
    "downloads",
    "declarativeNetRequest",
    "activeTab",
    "tabs",
    "clipboardRead",
    "clipboardWrite",
    "alarms",
    "unlimitedStorage",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.facebook.com/ads/library/*",
    "https://viva-labs-monitor.onrender.com/*",
    "https://zkgohmayzleupmswaeqh.supabase.co/*",
    "https://discord.com/api/webhooks/*",
    "https://discordapp.com/api/webhooks/*",
    "https://api.telegram.org/*",
    "https://app.vivalabs.com.br/*",
    "https://www.proxysite.com/*",
    "https://*.instagram.com/*",
    "https://*.facebook.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/ads/library/*"],
      "js": ["intelligent_parser.js", "ranking_engine.js", "export_data.js", "content.js"],
      "css": ["content.css"]
    },
    {
      "matches": ["https://*.facebook.com/ads/library/*"],
      "js": ["react_sniffer.js"],
      "world": "MAIN"
    },
    {
      "matches": ["https://www.proxysite.com/*"],
      "js": ["proxy_helper.js"]
    },
    {
      "matches": [
        "https://*.instagram.com/*",
        "https://*.facebook.com/*"
      ],
      "exclude_matches": [
        "https://*.facebook.com/ads/library/*"
      ],
      "js": ["social_helper.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Viva Spy",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}